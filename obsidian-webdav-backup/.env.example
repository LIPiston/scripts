#!/usr/bin/env bash
# Copy this file to .env and edit the values. Keep .env private (chmod 600).

# Absolute path to the vault-git working tree on starxn.
VAULT_GIT_DIR="/root/path/to/vault-git"

# Gitea repository URL. Use the HTTPS clone URL, not the local .git path.
GIT_REMOTE="https://gitea.example.com/USERNAME/vault-git.git"
GIT_USERNAME="CHANGE_ME"
GIT_PASSWORD="CHANGE_ME"
# true: verify credentials and pull --ff-only before backup; false: verify only.
GIT_PULL="true"

# WebDAV base URL, without the final slash, for example:
# https://dav.example.com/remote.php/dav/files/USERNAME
WEBDAV_URL="https://webdav.example.com/dav"
WEBDAV_REMOTE_DIR="obsidian-vault"
WEBDAV_USER="CHANGE_ME"
WEBDAV_PASSWORD="CHANGE_ME"
